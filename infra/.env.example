# Copy to infra/.env and fill in. Never commit infra/.env.
POSTGRES_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Losing or replacing it makes every stored
# project file unreadable.
MASTER_KEY=
LUIBUI_ENV=dev

# Local development only (http://localhost:3000 and http://app.localhost:3000):
# ANNAHME_OFFEN=true
# APP_ORIGIN=http://app.localhost:3000
# SESSION_COOKIE_SECURE=false
