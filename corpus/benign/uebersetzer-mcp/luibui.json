{
  "$schema": "https://luibui.com/spec/luibui.schema.json",
  "schema_version": "1",
  "name": "beispiel/uebersetzer-mcp",
  "version": "2.0.0",
  "typ": "mcp-server",
  "beschreibung": "Übersetzt kurze Texte über einen Übersetzungsdienst.",
  "lizenz": "MIT",
  "einstieg": "src/index.js",
  "rechte": {
    "netzwerk": true,
    "dateien": { "lesen": [], "schreiben": [] },
    "shell": false,
    "zugangsdaten": false,
    "umgebungsvariablen": ["UEBERSETZER_URL"]
  },
  "endpunkte": [
    {
      "host": "translate.example",
      "zweck": "Text übersetzen",
      "land": "DE",
      "datenkategorien": ["nutzereingaben"],
      "rechtsgrundlage": "keine_uebermittlung"
    }
  ],
  "datenkategorien": ["nutzereingaben"],
  "speicherung": { "lokal": false, "dauer": "keine" }
}
